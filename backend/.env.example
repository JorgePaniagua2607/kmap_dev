FRONTEND_URL=http://localhost:5173

# ==========================================
# BASE DE DATOS MYSQL (XAMPP LOCAL) / RAILWAY
# ==========================================
DATABASE_URL="mysql://root:@localhost:3306/kmap"

# ==========================================
