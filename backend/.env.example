# ==========================================
# SERVICIO DE CORREO (NODEMAILER / RESEND)
# MODE: "console" (desarrollo) | "smtp" (producciÃ³n)
# ==========================================
EMAIL_MODE="console"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notificaciones@plankmap.edu.bo"
