# ==========================================
# ALMACENAMIENTO DE ARCHIVOS (MULTER / S3)
# ==========================================
STORAGE_MODE="local"
UPLOAD_DIR="uploads"
MAX_FILE_SIZE_MB=15

# ==========================================
# SERVICIO DE IA GENERATIVA (QUIZZES)
